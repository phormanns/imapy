<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="https://jakarta.ee/xml/ns/jakartaee"
          xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
          id="WebApp_ID" version="6.0">
    <display-name>IMAPy Webmail</display-name>

    <filter>    
        <filter-name>CSRFTokenFilter</filter-name>    
        <filter-class>de.jalin.webmail.CSRFTokenFilter</filter-class>
    </filter>
    <filter-mapping>    
        <filter-name>CSRFTokenFilter</filter-name>    
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>MailboxServlet</servlet-name>
        <servlet-class>de.jalin.webmail.MailboxServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MailboxServlet</servlet-name>
        <url-pattern>/mailbox</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>FolderServlet</servlet-name>
        <servlet-class>de.jalin.webmail.FolderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FolderServlet</servlet-name>
        <url-pattern>/folder/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>MessageServlet</servlet-name>
        <servlet-class>de.jalin.webmail.MessageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MessageServlet</servlet-name>
        <url-pattern>/message/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AttachmentServlet</servlet-name>
        <servlet-class>de.jalin.webmail.AttachmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttachmentServlet</servlet-name>
        <url-pattern>/attachment/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>FolderListServlet</servlet-name>
        <servlet-class>de.jalin.webmail.FolderListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FolderListServlet</servlet-name>
        <url-pattern>/folderlist</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>de.jalin.webmail.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>de.jalin.webmail.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>403</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
</web-app>